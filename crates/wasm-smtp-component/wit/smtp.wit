/// wasm-smtp SMTP submission component interface.
///
/// This WIT world exposes a single `smtp-send` interface for sending one
/// email message per call. The component is implemented in Rust on top of
/// `wasm-smtp` + `wasm-smtp-wasi` and targets `wasm32-wasip2`.
///
/// ## Building
///
/// ```sh
/// cargo build --target wasm32-wasip2 -p wasm-smtp-component
/// # Produces: target/wasm32-wasip2/debug/wasm_smtp_component.wasm
/// ```
///
/// No `cargo-component`: the target emits a component on its own. Running
/// it needs a WASI 0.2 host; the `@0.2.12` below is the minor these
/// bindings come from, and any 0.2.x host satisfies it.
///
/// ## Language bindings
///
/// Generate bindings for any language that supports WIT. Point the
/// generator at the `wit` directory, so it also loads the WASI packages
/// vendored under `wit/deps/`:
///
/// ```sh
/// # TypeScript / JavaScript (via jco)
/// jco types wit -o ./types
///
/// # Go (via wit-bindgen go)
/// wit-bindgen go wit --out-dir ./smtp
///
/// # Python (via componentize-py)
/// componentize-py --wit-path wit bindings .
/// ```
///
/// ## Security note
///
/// Credentials (`smtp-credentials`) are passed as plain WIT strings and
/// cross the host-component boundary in each call. They are not retained
/// by the component between calls. See docs/src/adapters/component-model.md for
/// the credential handling threat model.
///
/// Trust anchors (`trust-anchors::custom`) are public CA certificates, not
/// secrets, so they are not covered by those rules even though an
/// `smtp-config` holds them for its lifetime.

package wasm-smtp:smtp@0.2.0;

/// SMTP send interface — one function, one message, one connection.
interface smtp-send {

    // ── Connection configuration ───────────────────────────────────────────

    /// How to establish TLS for the SMTP connection.
    enum tls-mode {
        /// Implicit TLS (port 465). Recommended. The TLS handshake occurs
        /// before any SMTP bytes are exchanged.
        implicit,
        /// STARTTLS upgrade (port 587). Plain TCP connect followed by an
        /// in-place TLS handshake after the SMTP STARTTLS command.
        starttls,
    }

    /// Which certificate authorities the TLS connection trusts.
    ///
    /// There is no value that disables certificate or hostname
    /// verification, and none will be added.
    variant trust-anchors {
        /// The bundled Mozilla root set. The right choice for public
        /// submission servers.
        bundled,
        /// Exactly these certificate authorities, and no others: PEM text
        /// holding one or more `CERTIFICATE` blocks, as a CA bundle file
        /// does. Text between blocks, such as comments, is ignored.
        ///
        /// This **replaces** the bundled roots. A caller who also wants
        /// public roots must include them in the bundle.
        ///
        /// Checked completely when the configuration is created: at most
        /// 64 blocks and 256 KiB; every block must be a certificate the
        /// root store accepts, or creation fails. A line that looks like a
        /// PEM boundary but is not an exact one, or is one in the wrong
        /// place, also fails creation: it is never skipped as a comment.
        /// A rejected bundle never falls back to `bundled`.
        custom(string),
    }

    /// A validated, immutable connection configuration.
    ///
    /// Created once with `create`, which performs every check on its
    /// arguments, and then only read: there are no setters, so a
    /// configuration that was accepted cannot later become invalid, and
    /// `send` never fails because of it. One configuration may be used for
    /// any number of sends.
    ///
    /// New connection options arrive as additional functions on this
    /// resource in compatible versions of the package, not as changes to
    /// `create`.
    resource smtp-config {
        /// Validate and create a configuration.
        ///
        /// - `host`: hostname or IP address of the SMTP submission server.
        /// - `port`: TCP port. Common values: 465 (implicit TLS), 587
        ///   (STARTTLS).
        /// - `ehlo-domain`: FQDN or address literal sent in `EHLO`,
        ///   identifying this client to the server.
        /// - `tls-mode`: implicit TLS or STARTTLS.
        /// - `trust`: which certificate authorities to trust.
        ///
        /// Fails with `send-error::invalid-input` when the EHLO domain or the
        /// trust anchors are rejected. A trust-anchor error names the
        /// offending block by position and the kind of problem, and never
        /// repeats any of the supplied text: that text might be a private
        /// key pasted by mistake.
        create: static func(
            host: string,
            port: u16,
            ehlo-domain: string,
            tls-mode: tls-mode,
            trust: trust-anchors,
        ) -> result<smtp-config, send-error>;
    }

    // ── Authentication ─────────────────────────────────────────────────────

    /// SMTP authentication credentials.
    ///
    /// Passed as function arguments on each `send` call. Not retained by
    /// the component between calls. The component selects the best
    /// available AUTH mechanism (SCRAM-SHA-256 > PLAIN > LOGIN).
    record smtp-credentials {
        /// Account username (typically an email address).
        username: string,
        /// Account password or app-specific password.
        password: string,
    }

    // ── Message ────────────────────────────────────────────────────────────

    /// A single SMTP message: envelope + body.
    record smtp-message {
        /// Envelope sender address (used in MAIL FROM).
        %from: string,
        /// Envelope recipient addresses (used in RCPT TO, one per entry).
        to: list<string>,
        /// Fully composed RFC 5322 message body: headers, a blank line,
        /// and content, with CRLF line endings.
        ///
        /// The component applies dot-stuffing and the end-of-data terminator
        /// automatically. Do not include them in this field.
        raw-message: string,
    }

    // ── Result ─────────────────────────────────────────────────────────────

    /// Successful send result.
    record send-result {
        /// SMTP reply code from the server's DATA acceptance response
        /// (typically 250).
        reply-code: u16,
    }

    /// Error returned when the send operation fails.
    variant send-error {
        /// Transport-level failure: DNS lookup, TCP connect, or TLS
        /// handshake error. The string is a human-readable description.
        io(string),
        /// SMTP protocol error: unexpected reply code, malformed server
        /// reply, or unsupported extension. The string identifies the
        /// failed SMTP operation.
        protocol(string),
        /// Authentication rejected by the server (535 or equivalent).
        auth-rejected,
        /// Caller-supplied input is invalid: empty from address, empty
        /// recipient list, or address containing forbidden characters; or,
        /// from `smtp-config.create`, an EHLO domain or trust anchors that
        /// were rejected.
        invalid-input(string),
        /// A send policy rejected the message before any SMTP command
        /// was sent.
        policy-rejected(string),
    }

    // ── Primary entry point ────────────────────────────────────────────────

    /// Connect to the SMTP server, authenticate, send one message, and quit.
    ///
    /// A new TCP connection is created for each call. Connection reuse is
    /// not exposed through this interface; use the Rust API directly for
    /// high-throughput scenarios that benefit from connection reuse.
    ///
    /// The component applies CRLF-normalised dot-stuffing to `raw-message`
    /// automatically.
    ///
    /// `config` is borrowed: the caller keeps it, and may reuse it for
    /// further sends. `send` performs no configuration checks of its own;
    /// those all happened in `smtp-config.create`.
    ///
    /// # Example (pseudocode)
    ///
    /// ```
    /// let config = smtp-config.create(
    ///   "smtp.example.com", 465, "client.example.com", implicit,
    ///   trust-anchors::bundled,
    /// )?;
    /// // For a server behind a private CA instead:
    /// //   trust-anchors::custom(read-file("corporate-root-ca.pem"))
    ///
    /// let result = smtp-send.send(
    ///   config,
    ///   smtp-credentials { username: "user@example.com",
    ///                      password: "secret" },
    ///   smtp-message {
    ///     from: "user@example.com",
    ///     to: ["recipient@example.org"],
    ///     raw-message: "From: user@example.com\r\n\
    ///                   To: recipient@example.org\r\n\
    ///                   Subject: Hello\r\n\r\nBody.\r\n",
    ///   },
    /// );
    /// ```
    send: func(
        config: borrow<smtp-config>,
        credentials: smtp-credentials,
        message: smtp-message,
    ) -> result<send-result, send-error>;
}

/// The SMTP client world.
///
/// A component implementing this world imports WASI networking interfaces
/// and exports the `smtp-send` interface.
world smtp-client {
    /// DNS lookup, TCP sockets, and byte streams.
    import wasi:sockets/instance-network@0.2.12;
    import wasi:sockets/network@0.2.12;
    import wasi:sockets/tcp@0.2.12;
    import wasi:sockets/tcp-create-socket@0.2.12;
    import wasi:sockets/ip-name-lookup@0.2.12;
    import wasi:io/streams@0.2.12;
    import wasi:io/poll@0.2.12;

    export smtp-send;
}
